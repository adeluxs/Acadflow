# ============================================================================
# AcadFlow Enterprise - Complete Environment Example
# ============================================================================
# Copy this file to .env and change values for your environment.
# Never commit a real .env file or production secrets to source control.
# Runtime feature availability is managed in Admin > Settings > Features & Modules
# and is intentionally NOT duplicated here.
# ============================================================================

# Application
APP_NAME=AcadFlow
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Framework / CLI
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Application maintenance mode
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Authentication
AUTH_GUARD=web
AUTH_MODEL="App\\Models\\User"
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800
AUTH_TWO_FACTOR_SESSION_HOURS=12

# Academic demo seeding (development/testing only)
ACADEMIC_SEED_DEMO=false
ACADEMIC_DEMO_PASSWORD=

# Database - MySQL is the recommended AcadFlow deployment target
DB_CONNECTION=mysql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=acadflow
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=false
MYSQL_ATTR_SSL_CA=

# Cache
CACHE_STORE=database
CACHE_PREFIX=
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_STORE=
SESSION_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# Redis
REDIS_CLIENT=phpredis
REDIS_CLUSTER=redis
REDIS_PREFIX=
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

# Memcached
MEMCACHED_PERSISTENT_ID=
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# DynamoDB cache (optional)
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=

# Queue
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
BEANSTALKD_QUEUE_HOST=localhost
BEANSTALKD_QUEUE=default
BEANSTALKD_QUEUE_RETRY_AFTER=90
SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
SQS_QUEUE=default
SQS_SUFFIX=

# Broadcasting / realtime
BROADCAST_DRIVER=log
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=8080
REVERB_SCHEME=http
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

# Filesystem
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_DAILY_DAYS=14
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME="AcadFlow Log"
LOG_SLACK_EMOJI=:boom:
LOG_PAPERTRAIL_HANDLER="Monolog\\Handler\\SyslogUdpHandler"
PAPERTRAIL_URL=
PAPERTRAIL_PORT=
LOG_STDERR_FORMATTER=
LOG_SYSLOG_FACILITY=8

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_URL=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_LOG_CHANNEL=

# Postmark / Resend
POSTMARK_TOKEN=
POSTMARK_MESSAGE_STREAM_ID=
RESEND_KEY=

# Slack notifications
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# SMS provider
SMS_BASE_URL=https://api.sms-provider.com/v1
SMS_SENDER_ID=AcadFlow
SMS_API_KEY=

# Sanctum / API authentication
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_TOKEN_PREFIX=

# Centralized media security and expiring delivery
MEDIA_MALWARE_SCANNER=none
MEDIA_SCAN_FAIL_CLOSED=true
MEDIA_DOWNLOAD_TOKEN_MINUTES=15
MEDIA_PREVIEW_TOKEN_MINUTES=5
CLAMAV_BINARY=clamscan
CLAMAV_TIMEOUT=30

# Submission system
SUBMISSION_GRACE_PERIOD=7
REQUIRE_PAYMENT=true
SUBMISSION_MAX_FILE_SIZE_MB=50
SUBMISSION_MAX_FILE_COUNT=10
SUBMISSION_MAX_TOTAL_SIZE_MB=500
SUBMISSION_ALLOW_LATE=true
SUBMISSION_LATE_PENALTY_PERCENT=10
SUBMISSION_MAX_LATE_PENALTY_PERCENT=50
SUBMISSION_DEFAULT_FORMAT=file
# Empty means unlimited
SUBMISSION_MAX_RESUBMISSIONS=
SUBMISSION_GROUP_MIN_SIZE=1
SUBMISSION_GROUP_MAX_SIZE=6
SUBMISSION_DEADLINE_WARNING_DAYS=3
SUBMISSION_DEADLINE_URGENT_HOURS=24
SUBMISSION_NOTIFY_DEADLINE_APPROACHING=true
SUBMISSION_NOTIFY_RECEIVED=true
SUBMISSION_NOTIFY_GRADE_POSTED=true
SUBMISSION_NOTIFY_CORRECTION_REQUESTED=true
SUBMISSION_STORAGE_DISK=local
SUBMISSION_STORAGE_PATH=submissions

# Academic catalogue synchronization
ACADEMIC_CATALOG_REMOTE_SYNC=true
ACADEMIC_CATALOG_SEED_TEMPLATES=true
ACADEMIC_CATALOG_HTTP_TIMEOUT=20
NUC_FEDERAL_UNIVERSITIES_URL=https://www.nuc.edu.ng/nigerian-univerisities/federal-univeristies/
NUC_STATE_UNIVERSITIES_URL=https://www.nuc.edu.ng/nigerian-univerisities/state-univeristies/
NUC_PRIVATE_UNIVERSITIES_URL=https://www.nuc.edu.ng/nigerian-univerisities/private-univeristies/
NBTE_POLYTECHNIC_SOURCE_URL=https://www.digitalnbte.nbte.gov.ng/Public/PUCPolytechnics
NBTE_APPROVED_INDEX_URL=https://www.web.nbte.gov.ng/tvet%20institutions
NIGERIA_INSTITUTION_FALLBACK_URL=https://raw.githubusercontent.com/awesomegoodman/higher-institutions-ng/main/resources/NARR/NARR%20institution.csv

# AI Academic Assistant - core
AI_DEFAULT_MODE=rule_based
AI_DEFAULT_PROVIDER=rule_based
AI_FALLBACK_PROVIDER=rule_based
AI_REQUEST_TIMEOUT=30
AI_MAX_TOKENS=2048
AI_DAILY_REQUEST_LIMIT=1000
AI_MONTHLY_REQUEST_LIMIT=30000
AI_MAX_COST=100.0
AI_SIMILARITY_THRESHOLD=20
AI_MAX_DOCUMENT_SIZE_MB=20
AI_CACHE_TTL=86400
AI_ENABLE_RULE_ENGINE=true
AI_ENABLE_EXTERNAL_AI=false
AI_ENABLE_HYBRID_MODE=true
AI_ENABLE_CACHE=true
AI_ENABLE_LOGGING=true
AI_HYBRID_ESCALATE_WHEN_CLEAN=false
# Empty means use application default queue connection
AI_QUEUE_CONNECTION=

# AI document layout defaults
AI_LAYOUT_PAGE_SIZE=A4
AI_LAYOUT_MIN_MARGIN_INCHES=1.0
AI_LAYOUT_LINE_SPACING=1.5
AI_LAYOUT_MIN_FONT_SIZE=10
AI_LAYOUT_REQUIRE_PAGE_NUMBERING=false
AI_LAYOUT_REQUIRE_BRANDING=false

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_INPUT_COST_PER_MILLION=0.15
OPENAI_OUTPUT_COST_PER_MILLION=0.60

# Anthropic / Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest
CLAUDE_TEMPERATURE=0.2
CLAUDE_INPUT_COST_PER_MILLION=3.00
CLAUDE_OUTPUT_COST_PER_MILLION=15.00

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_INPUT_COST_PER_MILLION=0.10
GEMINI_OUTPUT_COST_PER_MILLION=0.40

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_INPUT_COST_PER_MILLION=0.27
DEEPSEEK_OUTPUT_COST_PER_MILLION=1.10

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_TEMPERATURE=0.2
AZURE_OPENAI_INPUT_COST_PER_MILLION=0.15
AZURE_OPENAI_OUTPUT_COST_PER_MILLION=0.60

# Ollama / local AI
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TEMPERATURE=0.2
OLLAMA_INPUT_COST_PER_MILLION=0
OLLAMA_OUTPUT_COST_PER_MILLION=0

# Scholarly discovery providers
SCHOLARLY_CONTACT_EMAIL=
ORCID_PUBLIC_API_URL=https://pub.orcid.org/v3.0
OPENALEX_BASE_URL=https://api.openalex.org
CROSSREF_BASE_URL=https://api.crossref.org
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=
CORE_BASE_URL=https://api.core.ac.uk/v3
CORE_API_KEY=
DOAJ_BASE_URL=https://doaj.org/api
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
ARXIV_BASE_URL=https://export.arxiv.org

# Reputation weighting
REPUTATION_WEIGHT_KNOWLEDGE=0.30
REPUTATION_WEIGHT_QUALITY=0.30
REPUTATION_WEIGHT_RESEARCH=0.30
REPUTATION_WEIGHT_COMMUNITY=0.10

# Reputation points
REPUTATION_POINTS_PUBLICATION=12
REPUTATION_POINTS_BOOKMARK=0.7
REPUTATION_POINTS_VIEW=0.02
REPUTATION_POINTS_CITATION=5
REPUTATION_POINTS_FEATURED_PUBLICATION=8
REPUTATION_POINTS_APPROVED_RESEARCH_QUALITY=10
REPUTATION_POINTS_CITATION_RESEARCH_IMPACT=8
REPUTATION_POINTS_APPROVED_RESEARCH_IMPACT=15
REPUTATION_POINTS_RESEARCH_OUTPUT=6
REPUTATION_POINTS_FOLLOWER=2
REPUTATION_POINTS_COMMENT=0.8
REPUTATION_POINTS_REACTION=0.4

# Reputation level thresholds
REPUTATION_LEVEL_HALL_OF_KNOWLEDGE=2500
REPUTATION_LEVEL_PROFESSOR_CIRCLE=1500
REPUTATION_LEVEL_DISTINGUISHED_RESEARCHER=1000
REPUTATION_LEVEL_RESEARCH_FELLOW=700
REPUTATION_LEVEL_NATIONAL_CONTRIBUTOR=450
REPUTATION_LEVEL_UNIVERSITY_SCHOLAR=250
REPUTATION_LEVEL_FACULTY_EXPERT=120
REPUTATION_LEVEL_DEPARTMENT_EXPERT=60
REPUTATION_LEVEL_CAMPUS_CONTRIBUTOR=20
REPUTATION_LEVEL_NEW_CONTRIBUTOR=0

# Frontend / Vite
VITE_APP_NAME="${APP_NAME}"

# Existing application compatibility settings
ONBOARDING_VERSION=1
EVENT_REMINDER_QUEUE=notifications
